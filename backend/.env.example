PORT=5000
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@aexto.com
ADMIN_PASSWORD=choose-a-strong-password
# MongoDB: the connection string of your cluster, and a database name of this project's own.
# Use a different name for local work (aexto_website_dev) than for the live site (aexto_website).
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/
MONGODB_DB=aexto_website_dev
